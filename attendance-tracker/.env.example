# Twilio SMS for OTP. If unset, the app runs in OTP dev mode and shows the OTP on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Prefix added to 10-digit mobile numbers
DEFAULT_COUNTRY_CODE=+91
# Set to "true" to show OTPs on screen even in production (testing only)
OTP_DEV_MODE=
